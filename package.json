{
  "name": "fixsight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FixSight — point your camera at a problem, get a first-level expert diagnosis.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/diagnosis-contract.test.ts test/scans-workflow.test.ts test/voice.test.ts test/ai-mock.test.ts test/v5-safety-and-guards.test.ts test/image-processing.test.ts test/web-modules.test.ts",
    "eval": "tsx scripts/evaluate.ts",
    "verify:voice": "tsx scripts/verify-voice.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "sync:contract": "tsx scripts/sync-contract.ts",
    "demo": "tsx scripts/demo.ts",
    "test:e2e": "tsx --test --test-concurrency=1 test/e2e/workflows.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "jspdf": "^4.2.1",
    "playwright-core": "^1.65.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}

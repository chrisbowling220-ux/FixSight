# Copy this file to .env and paste your Anthropic API key
# Get one at https://platform.claude.com/ -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: change the port the app runs on
# PORT=3000

# ElevenLabs — powers voice (speech-to-text + text-to-speech). Optional: leave
# blank and the mic simply never appears. The browser never sees this key; all
# voice calls go through the server. Set the same key in Vercel for production.
ELEVENLABS_API_KEY=

# Optional voice overrides (sensible defaults live in src/config.ts):
#   the one shared "brand" voice the whole Contractors Office suite speaks in —
#   set this to the chosen ElevenLabs Voice Library / Voice Design id.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2

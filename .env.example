# Copy this file to .env and fill in what you need. Never commit .env.
#
# No key at all? Run `npm run demo` instead: the app works fully with clearly
# labelled sample results and makes no paid calls.

# --- AI analysis (Anthropic). Each analysis is a paid API call. ---
ANTHROPIC_API_KEY=
# Model used for analysis. Default claude-opus-5. claude-opus-5-5 is newer and
# cheaper; switch after running the evaluation (see evaluation/README.md).
# FIXSIGHT_MODEL=claude-opus-5
# FIXSIGHT_EFFORT=high
# FIXSIGHT_MAX_TOKENS=16000
# Optional refusal fallback (beta, off by default; test once before enabling).
# FIXSIGHT_REFUSAL_FALLBACK_MODEL=claude-opus-4-8

# --- Cost protection ---
# Per-server-instance daily cap on paid analyses (runaway-loop backstop).
# ANALYSIS_DAILY_CAP=300
# Requests per IP per window for analysis and voice.
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=900000
# Shared access code required for analysis and voice. Strongly recommended on
# any public URL. Users enter it once in Settings.
# FIXSIGHT_ACCESS_CODE=
# Set to true behind a proxy/CDN (Vercel) so rate limits see real client IPs.
# TRUST_PROXY=true

# --- Voice (ElevenLabs). Optional; the device's free voice is the default. ---
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2
# VOICE_DAILY_TTS_CHARS=200000
# VOICE_DAILY_STT_SECONDS=3600

# --- Server ---
# PORT=3000
# Demo mode: sample results, no AI calls (same as `npm run demo`).
# FIXSIGHT_DEMO_MODE=false
